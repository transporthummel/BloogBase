{
  "name": "bloogbase",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:all": "node scripts/test-all.mjs",
    "typecheck": "tsc --noEmit",
    "index:add": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example index_add --",
    "index:check": "cargo run --quiet --manifest-path index/tool/Cargo.toml -- check --download",
    "index:build": "cargo run --quiet --manifest-path index/tool/Cargo.toml -- build --out index/dist --key .local/index-signing/minisign.key",
    "licenses:generate": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@uiw/react-codemirror": "4.25.12",
    "i18next": "26.7.2",
    "lucide-react": "1.70.0",
    "motion": "14.9.1",
    "pako": "3.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
