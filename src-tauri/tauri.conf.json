{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BloogBase",
  "version": "0.1.0",
  "identifier": "de.transporthummel.bloogbase",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BloogBase",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0d0c1d"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "transporthummel",
    "homepage": "https://github.com/transporthummel/BloogBase",
    "category": "Game",
    "shortDescription": "A launcher for Commander Keen and its mods",
    "copyright": "Copyright © 2026 transporthummel. Commander Keen is a trademark of id Software.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "headerImage": "icons/installer/header.bmp",
        "languages": ["English", "German"],
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/installer/dmg.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      },
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNTkwRTE1QjgyNDA5QzUKUldURkNTUzRGUTVaVWpRU3lFTkhVOW5ic0ljdWd1QmJKSjBxVDRGcXNtUFJRNVJTcS91OFVMUTUK",
      "endpoints": [
        "https://github.com/transporthummel/BloogBase/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
