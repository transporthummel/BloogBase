    "backups": [
      {
        "profile": "keen6",
        "label": "Before the Bloogdome"
      }
    ],
    "saves": [
      {
        "profile": "keen6",
        "from": "versions/Commander Keen 6 v1.0 (hacked)",
        "files": ["SAVEGAM0.CK6", "SAVEGAM1.CK6", "SAVEGAM2.CK6"]
      }
    ]
  },
  "shots": [
    {
      "name": "library",
      "description": "README hero: the library in Midnight Galaxy, sorted by last played, with title-screen covers of games and mods, play time and the fun fact.",
      "route": "/",
      "languages": ["en", "de"]
    },
    {
      "name": "discover",
      "description": "Mods with one click, and the dark half of Two themes: Discover's mod list, recommended first, with badges for installed mods.",
      "route": "/discover",
      "languages": ["en", "de"]
    },
    {
      "name": "keenwiki",
      "description": "Any mod from KeenWiki: the add dialog after looking up a KeenWiki page that isn't in the mod list, showing what the page says.",
      "route": "/",
      "steps": [
        {
          "clickText": {
            "en": "Add game or mod",
            "de": "Spiel oder Mod hinzufügen"
          }
        },
        {
          "fill": "#keenwiki-url",
          "value": "https://keenwiki.shikadi.net/wiki/Buried_in_Oblivion"
        },
        {
          "clickText": {
            "en": "Look up",
            "de": "Nachsehen"
          }
        },
        {
          "waitText": {
            "en": "Download and check",
            "de": "Herunterladen und prüfen"
          },
          "timeout": 30000
        }
      ],
      "clip": "[role=dialog]",
      "clipPadding": 24,
      "languages": ["en", "de"]
    },
    {
      "name": "setup",
      "description": "Ready on the first start: the setup wizard's mod step, suggesting recommended mods for the games found.",
      "route": "/setup",
      "invoke": [
        {
          "cmd": "set_setup_step",
          "args": {
            "step": "mods"
          }
        }
      ],
      "languages": ["en", "de"]
    },
    {
      "name": "saves",
      "description": "Your saves are safe: Keen 6's saves tab with save details and a backup.",
      "route": "/profiles/{profile:keen6}",
      "steps": [
        {
          "clickText": {
            "en": "Saves",
            "de": "Spielstände"
          },
          "selector": "[role=tab]"
        }
      ],
      "languages": ["en", "de"]
    },
    {
      "name": "mod-page",
      "description": "A fan museum: a mod's page with its title screen, credits, links and readme.",
      "route": "/profiles/{profile:the-alphamatic}",
      "height": 1000,
      "languages": ["en", "de"]
    },
    {
      "name": "library-light",
      "description": "The website's theme comparison: the library in Vintage Beige, next to library.png.",
      "route": "/",
      "theme": "light",
      "languages": ["en", "de"]
    },
    {
      "name": "discover-light",
      "description": "Two themes: Discover's mod list in Vintage Beige, next to discover.png.",
      "route": "/discover",
      "theme": "light",
      "languages": ["en", "de"]
    }
  ]
}
